{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "droidnative",
  "version": "0.3.0",
  "identifier": "io.droidnative.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DroidNative",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.local/share/waydroid/data/icons/*.png"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Applicazioni Android native su Linux",
    "longDescription": "DroidNative installa ed esegue applicazioni Android in un container Waydroid, rileva l'hardware e configura l'accelerazione GPU verificandola sul renderer reale.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1",
          "curl",
          "gpg"
        ],
        "files": {
          "/usr/bin/droidnative": "../../target/release/droidnative",
          "/usr/share/polkit-1/actions/io.droidnative.policy": "../../packaging/io.droidnative.policy",
          "/usr/share/doc/droidnative/copyright": "../../packaging/copyright"
        },
        "recommends": [
          "pciutils"
        ],
        "section": "utils",
        "desktopTemplate": "droidnative.desktop.hbs"
      }
    },
    "publisher": "Foglio24",
    "homepage": "https://github.com/Foglio24/droidnative",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "copyright": "Copyright © 2026 Foglio24 and DroidNative contributors"
  }
}
